<launch>
  <param name="/use_sim_time" value="true"/>

  <arg name="rviz" default="false"/>
  <arg name="use_centerpp" default="true"/>
  <arg name="robot_namespace" default="fast_livo"/>
  <arg name="pointcloud_topic" default="/kitti/velo/pointcloud"/>
  <arg name="odom_topic" default="/aft_mapped_to_init"/>

  <rosparam command="load" file="$(find fast_livo)/config/velodyne_KITTI.yaml"/>

  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(find fast_livo)/config/camera_pinhole_KITTI.yaml"/>
  </node>

  <group if="$(arg use_centerpp)">
    <include file="$(find fast_livo)/launch/centerpp.launch">
      <arg name="robot_namespace" value="$(arg robot_namespace)"/>
      <arg name="pointcloud_topic" value="$(arg pointcloud_topic)"/>
      <arg name="odom_topic" value="$(arg odom_topic)"/>
    </include>
  </group>

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
          args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz"/>
  </group>
</launch>
